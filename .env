# Docker Compose settings, read automatically by `docker compose`. Override any of them in your shell,
# e.g. `APP_PORT=9090 docker compose up`. Don't put real secrets here; set VENDOR_API_KEY in your shell instead.

# Versions of the build/runtime images (passed to the Dockerfile and the dev containers).
NODE_VERSION=26
# Keep in sync with javaVersion in backend/gradle.properties.
JAVA_VERSION=17

# Port on your machine for the app (Docker image and dev-mode backend).
APP_PORT=8080
# Port on your machine for the dev-mode frontend (Vite dev server).
FRONTEND_DEV_PORT=5173
